#!/bin/bash -l
#PBS -N hgq_ddp_val
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -q debug
#PBS -j oe
#PBS -o logs/hgq_ddp_validate.log
#
# Submit with:  bash polaris/submit.sh 06_ddp_validate.pbs
#
# OPTIONAL. Only needed if you want ONE training spread across all 4 GPUs instead of
# 4 independent runs (05_sweep.pbs). DDP over the Keras-torch/HGQ2 stack has never
# been validated; this decides whether it is safe, rather than assuming.
#
# Two stack-specific hazards it checks:
#   1. Quantized layers build LAZILY at first forward — ranks can end up registering
#      different parameter sets.
#   2. Quantizer layer names are embedded in state_dict keys — they must agree ACROSS
#      RANKS, or checkpoints silently become rank-dependent.
# A DDP failure here is usually silent (wrong numbers), not a crash — hence the
# explicit assertions.
set -uo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
source polaris/env.sh
export PYTHONNOUSERSITE=1 KERAS_BACKEND=torch TORCHDYNAMO_DISABLE=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

REPO="$WORK_ROOT/hepattn"; cd "$REPO"
PY="$REPO/.venv/bin/python"
mkdir -p logs

NGPU=$(nvidia-smi -L | wc -l)
echo "=== validating DDP on $NGPU GPUs ==="

PYTHONPATH="$REPO/src" DATA_DIR="$DATA_ROOT" CKPT_DIR="$WORK_ROOT/ddp_ckpts" \
  "$PY" polaris/03_make_config.py

echo "=== 1. two-rank fit, few steps ==="
PYTHONPATH="$REPO/src" "$PY" -m hepattn.experiments.clic.main_hgq fit \
  --config polaris_hgq.yaml \
  --trainer.devices 2 \
  --trainer.strategy ddp \
  --trainer.limit_train_batches 10 \
  --trainer.limit_val_batches 2 \
  --trainer.max_epochs 1 \
  --trainer.default_root_dir "$WORK_ROOT/ddp_run"
STATUS=$?
echo "DDP-FIT-EXIT-$STATUS"
[ $STATUS -ne 0 ] && { echo "DDP-VERDICT: FAILED TO RUN — stay with 05_sweep.pbs"; exit 0; }

echo "=== 2. checkpoint sanity: keys, finiteness, quantizers present ==="
PYTHONPATH="$REPO/src" "$PY" - <<'EOF'
import glob, os, torch
cks = sorted(glob.glob(os.environ["WORK_ROOT"] + "/ddp_ckpts/*.ckpt"), key=os.path.getmtime)
if not cks:
    raise SystemExit("DDP-VERDICT: no checkpoint written — do not trust DDP")
sd = torch.load(cks[-1], map_location="cpu", weights_only=False)["state_dict"]
q = [k for k in sd if "quantizer" in k]
bad = [k for k, v in sd.items() if torch.is_floating_point(v) and not torch.isfinite(v).all()]
print(f"tensors={len(sd)}  quantizer_vars={len(q)}  non_finite={len(bad)}")
assert q, "DDP-VERDICT: no quantizer parameters — quantization inactive under DDP"
assert not bad, f"DDP-VERDICT: non-finite parameters: {bad[:3]}"
print("DDP-CKPT-OK")
EOF

echo
echo "=== 3. does DDP agree with single-GPU? (same seed, same steps) ==="
# The decisive check: a correct DDP run must reach a comparable loss. A large
# divergence means the quantizer state is not being handled consistently.
PYTHONPATH="$REPO/src" "$PY" -m hepattn.experiments.clic.main_hgq fit \
  --config polaris_hgq.yaml \
  --trainer.devices 1 \
  --trainer.limit_train_batches 10 \
  --trainer.limit_val_batches 2 \
  --trainer.max_epochs 1 \
  --trainer.default_root_dir "$WORK_ROOT/ddp_ref" > logs/ddp_ref.log 2>&1
echo "single-GPU reference val/loss:"; grep -aoE "val_loss=[0-9.]+" logs/ddp_ref.log | tail -1
echo "DDP val/loss:";                  grep -aoE "val_loss=[0-9.]+" logs/hgq_ddp_validate.log | tail -1

cat <<'EOF'

=== VERDICT ===
Compare the two val_loss values above. They will not be identical (different data
sharding), but they should be the same order of magnitude.

  similar   -> DDP is usable. Run one training on all GPUs by adding
               --trainer.devices 4 --trainer.strategy ddp
               and REMEMBER to rescale: DDP averages gradients across ranks, so the
               effective batch is devices x micro-batch x accum. Re-tune LR accordingly.

  divergent -> do NOT use DDP. Stay with 05_sweep.pbs (4 independent runs), which
               keeps every GPU busy anyway and carries no correctness risk.
EOF
