#!/bin/bash -l
#PBS -N clic-linformer
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=48:00:00
#PBS -j oe
#
# Submit with submit_linformer.sh, which injects -A / -q / -l filesystems from env.sh.
# One Polaris node = 4x A100-40GB. Lightning spawns the 4 DDP ranks itself
# (trainer.devices: 4), so this launches ONE python process, not mpiexec.

set -euo pipefail

export REPO_DIR="${REPO_DIR:?REPO_DIR not set}"
cd "${REPO_DIR}"
source polaris/env.sh

# A venv disables user-site by default, but be explicit: a stale ~/.local can shadow
# the venv's torch and produce a CUDA-version mismatch.
export PYTHONNOUSERSITE=1

# The venv and the repo live in DIFFERENT places on Polaris: deps were installed under
# WORK_ROOT (/eagle), while this branch is checked out in $HOME. hepattn itself is NOT
# installed into the venv (uv sync --no-install-project), so PYTHONPATH alone decides
# which clone runs -- and the /eagle clone sits on keras-hgq2. Get this wrong and the job
# trains the WRONG code and still looks healthy.
VENV_DIR="${VENV_DIR:-${WORK_ROOT}/hepattn/.venv}"
if [ ! -f "${VENV_DIR}/bin/activate" ]; then
  echo "FATAL: no venv at ${VENV_DIR} (override with VENV_DIR=...)" >&2
  exit 1
fi
source "${VENV_DIR}/bin/activate"
export PYTHONPATH="${REPO_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"

# Preflight: prove we are about to train THIS checkout, with linformer available.
python - <<PYCHK || exit 1
import os, sys, hepattn
repo = os.environ["REPO_DIR"]
if not hepattn.__file__.startswith(os.path.join(repo, "src")):
    sys.exit(f"FATAL: hepattn resolves to {hepattn.__file__}, not {repo}/src")
from hepattn.models.linformer import LinformerAttention  # noqa: F401
print(f"preflight OK: hepattn -> {hepattn.__file__}")
PYCHK

export OMP_NUM_THREADS=8            # 32 cores / 4 ranks
export COMET_OFFLINE_DIRECTORY="${WORK_ROOT}/comet-offline"
mkdir -p "$COMET_OFFLINE_DIRECTORY"

CFG=src/hepattn/experiments/clic/configs/linformer_polaris.yaml

# SMOKE: prove the config runs on real GPUs and real data before burning 30 h.
SMOKE_ARGS=""
if [ "${SMOKE:-0}" = "1" ]; then
  # >=40 steps required: OneCycleLR phase 1 spans (pct_start*total_steps - 1) steps, so
  # pct_start=0.05 with 20 steps gives a span of 0 and get_lr() divides by zero.
  # 100 also yields a usable it/s to extrapolate the 200-epoch wall time.
  SMOKE_ARGS="--trainer.max_epochs 1 --trainer.limit_train_batches 100 --trainer.limit_val_batches 10"
  echo "==> SMOKE MODE: 100 train / 10 val batches, 1 epoch"
fi

RESUME_ARG=""
if [ -n "${RESUME_CKPT:-}" ]; then
  RESUME_ARG="--ckpt_path ${RESUME_CKPT}"
  echo "==> resuming from ${RESUME_CKPT}"
fi

echo "==> host $(hostname)"
nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader
echo "==> starting $(date -Is)"

cd src/hepattn/experiments/clic
python main.py fit \
  --config "${REPO_DIR}/${CFG}" \
  --data.train_path "${DATA_ROOT}/train_clic_fix.root" \
  --data.valid_path "${DATA_ROOT}/val_clic_fix.root" \
  --data.test_path  "${DATA_ROOT}/val_clic_fix.root" \
  --trainer.devices 4 \
  --trainer.num_nodes 1 \
  ${SMOKE_ARGS} ${RESUME_ARG}

echo "==> finished $(date -Is)"
