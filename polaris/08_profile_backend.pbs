#PBS -q debug
#PBS -j oe
#PBS -o logs/hgq_profile_backend.log
#
# Submit with:  bash polaris/submit.sh 08_profile_backend.pbs
#
# Follows up 07_profile.pbs. 07 measured the step cost in a bare torch loop; this asks
# where the remaining time goes and which of the four candidate causes is real:
# batch size (launch-bound), the Hungarian matcher, PyTorch Lightning, or HGQ2 itself.
# One GPU on a debug node for ~20 min; safe to run alongside a training job.
set -uo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
source polaris/env.sh
export PYTHONNOUSERSITE=1 KERAS_BACKEND=torch TORCHDYNAMO_DISABLE=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

REPO="$WORK_ROOT/hepattn"; cd "$REPO"
mkdir -p logs

nvidia-smi --query-gpu=index,name,memory.total --format=csv | head -2

# PROF_EVENTS must be >= the largest batch in PROF_BATCHES.
CUDA_VISIBLE_DEVICES=0 PYTHONPATH="$REPO/src" \
  PROF_EVENTS=64 PROF_BATCHES=4,8,16,32,64 PROF_ITERS=12 DATA_ROOT="$DATA_ROOT" \
  "$REPO/.venv/bin/python" polaris/08_profile_backend.py
echo "PROFILE08-EXIT-$?"
