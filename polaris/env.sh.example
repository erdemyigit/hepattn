# Copy to polaris/env.sh and fill in from `bash polaris/00_discover.sh`.
# Every other script sources this file, so these are set in exactly one place.

# --- REQUIRED: from 00_discover.sh ------------------------------------------
export PBS_PROJECT="CHANGEME"          # -A value (your allocation/project)
export PBS_FILESYSTEMS="home:eagle"    # -l filesystems=... ; a job that omits a
                                       # filesystem it touches can be held/killed
export QUEUE_DEBUG="debug"             # short queue for smoke tests
export QUEUE_PROD="preemptable"       # 1-10 nodes, 72h. NOTE: preemptable jobs
                                       # can be killed at any time -- the sweep
                                       # checkpoints every 1000 steps and auto-resumes

# Where the ~12 GB of CLIC ROOT files live (NOT $HOME — too small, and not backed up
# for scratch data). Point at your project space, e.g. /eagle/<project>/clic
export DATA_ROOT="/eagle/${PBS_PROJECT}/clic"

# Where the repo + venv + checkpoints live. Project space is safer than $HOME.
export WORK_ROOT="/eagle/${PBS_PROJECT}/hepattn-hgq"

# --- Training knobs (defaults are the falcon-validated values) ---------------
export HGQ_BATCH=32                    # micro-batch per GPU (32 fits 40 GB in bf16)
export HGQ_ACCUM=4                     # -> effective batch 128
export HGQ_PRECISION="bf16-mixed"      # validated on CUDA: finite loss, quantizer grads flow
export HGQ_EPOCHS=20                   # beta trend is visible well before convergence
export HGQ_WARMUP_EPOCHS=1.0           # beta ramp length in EPOCHS (was a hardcoded 42000
                                       # steps = 5.4 epochs, so a sweep took days to show
                                       # anything). 1.0 puts full beta at epoch 2.
export WALLTIME_SMOKE="00:20:00"
export WALLTIME_PROD="72:00:00"   # preemptable allows up to 72h

# --- Beta sweep: one value per GPU ------------------------------------------
# CALIBRATED against the measured E_eff (polaris/09_measure_beta.py), NOT total_ebops.
# On polaris_hgq.yaml: E_eff = 2.88e11, so beta*E_eff as a fraction of a ~30 task loss is
#   5.2e-12 -> 5%    2.6e-11 -> 25%    1.04e-10 -> 100%    2.6e-10 -> 250%
# The previous range (4.0e-15 … 4.0e-12) topped out at 3.8% and was inert: four decades
# of beta moved the mean learned bitwidth by 0.01%. Re-run 09_measure_beta.py if you
# change the model, batch size or attention type — E_eff moves with all three.
export BETA_VALUES="5.2e-12 2.6e-11 1.04e-10 2.6e-10"

# --- Hygiene: never let ~/.local shadow the venv (the flash-attn/CUDA trap) ---
export PYTHONNOUSERSITE=1

# Evaluate the EBOPs penalty every N steps instead of every step (measured: 16.1% of
# step time on an A100). beta_end is scaled by N automatically so the time-averaged
# resource pressure is unchanged. Set to 1 to disable.
export HGQ_EBOPS_EVERY=8
